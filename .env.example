# Skopiuj do .env (cp .env.example .env) i zmień tylko to, co potrzebne.
# Wszystkie wartości mają domyślne - bez pliku .env projekt działa na portach poniżej.
# Dane logowania są wyłącznie do lokalnego środowiska deweloperskiego - nigdy ich nie używaj poza nim.

# --- Porty na Twoim komputerze (zmień, gdy któryś jest zajęty) ---
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Baza danych (czyta docker compose i backend) ---
POSTGRES_DB=apsi
POSTGRES_USER=apsi
POSTGRES_PASSWORD=apsi

# --- Konto administratora Keycloak (czyta docker compose) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Opcjonalnie: backend ---
# POSTGRES_HOST=localhost
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/apsi
# STORAGE_DIR=storage
